{
    "name": "nbcom/laravel-bitrix24",
    "description": "Typed Laravel client for Bitrix24 on-premise REST API: users, departments, notifications, stable DTOs and errors.",
    "keywords": [
        "laravel",
        "bitrix24",
        "bitrix",
        "rest",
        "api-client"
    ],
    "homepage": "https://github.com/SmoKE585/NBCom-Bitrix24-Laravel-Client",
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.2",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "illuminate/cache": "^12.0|^13.0",
        "illuminate/config": "^12.0|^13.0",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "mockery/mockery": "^1.6",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Nbcom\\Bitrix24\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nbcom\\Bitrix24\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nbcom\\Bitrix24\\Bitrix24ServiceProvider"
            ],
            "aliases": {
                "Bitrix24": "Nbcom\\Bitrix24\\Facades\\Bitrix24"
            }
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html build/coverage",
        "analyse": "phpstan analyse --memory-limit=1G",
        "format": "pint",
        "format:test": "pint --test",
        "check": [
            "@format:test",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
